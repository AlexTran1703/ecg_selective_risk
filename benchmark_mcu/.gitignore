# ---------------------------------------------------------------------------
# What this study produces, and what is worth keeping
# ---------------------------------------------------------------------------
# results/ is ~325 MB: trained checkpoints, ONNX exports, ST Edge AI
# workspaces and linked firmware images. All of it is regenerated by
# b1_train.py, b2_int8.py and b3_deploy.py, so none of it belongs in
# history.
#
# The exception is the small JSON written beside those artefacts. The
# deployment records in particular are measurements taken from a physical
# STM32F411 -- Flash, peak SRAM, DWT cycle counts -- and cannot be
# reproduced by anyone without the board in front of them. They total
# about 110 KB. Keeping them means the tables rebuild from a clean clone
# on a machine with no hardware attached.
results/**/*
!results/**/
!results/**/*.json

# ...but the ST toolchain writes its own JSON into the workspace and the
# generated C directory. That is tool output, not measurement, so it is
# excluded again after the rule above. Later rules win in gitignore.
results/**/ws/**
results/**/gen/**
results/**/fw/**

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# MCU and ST Edge AI build products, wherever they land
# ---------------------------------------------------------------------------
# stedgeai drops st_ai_output/ into the working directory, and the GCC
# link step leaves an ELF, a raw image and a map file per model.
st_ai_output/
*.onnx
*.elf
*.bin
*.map
*.o
*.a
*.su
*.d

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log

# ---------------------------------------------------------------------------
# LaTeX build artifacts
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# ---------------------------------------------------------------------------
# Kept deliberately
# ---------------------------------------------------------------------------
# figures/ and tables/ are the deliverables and are matched by nothing
# above. src/ and scripts/ are the method. REPORT.md, protocol.md and the
# .bib files are the write-up. They are listed here only so the intent is
# explicit to anyone editing this file.
!figures/
!tables/
!src/
!scripts/
!*.md
!*.bib
