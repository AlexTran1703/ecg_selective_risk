# ---------------------------------------------------------------------------
# Data: raw, and anything derived from it
# ---------------------------------------------------------------------------
# dataset/ is the 57 GB download; data/prepared/ is the 35 GB memmap built
# from it and data/cache/ the 8.7 GB intermediate. All are reproducible from
# scripts/01_prepare.py, so none belongs in history -- and a single commit of
# data/prepared/ would be unrecoverable without a rewrite.
dataset/
data/cache/
data/prepared/
archive/

# Kept deliberately: data/meta/ is a few hundred KB of index, and
# data/ensembles/ is ~7 MB of cached member predictions and weights. Those
# are what let every post-hoc change rerun in seconds instead of 110 minutes,
# so they are worth versioning.
!data/meta/
!data/ensembles/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# LaTeX build artifacts
# ---------------------------------------------------------------------------
# Only letter.tex, reference.bib and letter.pdf are deliverables; everything
# else is regenerated by a pdflatex run.
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.xdv

# ---------------------------------------------------------------------------
# Run outputs
# ---------------------------------------------------------------------------
artifacts/runs/
*.tmp
*.temp
tmp/
temp/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
